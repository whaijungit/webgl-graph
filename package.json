{
  "name": "china-transport-globe",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "module": "./dist-lib/traffic-graph.js",
  "main": "./dist-lib/traffic-graph.js",
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts",
      "import": "./dist-lib/traffic-graph.js"
    }
  },
  "types": "./src/lib/index.d.ts",
  "files": [
    "dist-lib",
    "src/lib/index.d.ts"
