    "build:npm-sample": "node scripts/build-npm-dependency-sample.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4317"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "5.9.3",
    "vite": "^7.0.0"
